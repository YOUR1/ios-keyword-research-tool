# =============================================================================
# Worst Rated iOS Apps Index — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=iosstore
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=iosstore

# Constructed DB URL (used by app)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# App Settings
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-random-secret-key
API_V1_PREFIX=/api/v1

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Crawl Settings
CRAWL_RATE_LIMIT_PER_MINUTE=20
CRAWL_DEFAULT_COUNTRY=US
CRAWL_MIN_RATING_THRESHOLD=100
CRAWL_BATCH_SIZE=50

# Weighted Score Settings
WEIGHTED_SCORE_MIN_RATINGS=100

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8282"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# ── Proxy Configuration ────────────────────────────────────────────────────
# Set PROXY_ENABLED=true to route iTunes API requests through residential proxies.
# Without proxies the app works fine, but Apple may rate-limit heavy crawling.
PROXY_ENABLED=false
PROXY_PRIMARY_PROVIDER=iproyal

# IPRoyal (recommended for MVP — no minimum spend, $1.75/GB)
# Sign up: https://iproyal.com/residential-proxies/
IPROYAL_USER=
IPROYAL_PASS=

# Bright Data (for scale — requires $500/mo minimum)
# Sign up: https://brightdata.com/
BRIGHTDATA_CUSTOMER_ID=
BRIGHTDATA_ZONE=
BRIGHTDATA_PASS=

# ── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8282/api/v1
BACKEND_URL=http://backend:8282
